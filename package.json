{
  "name": "z-biz-game-norinori-cos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "のりのり / Norinori —— 题面就是一张区域剖分：每块区域恰好两颗黑格，黑格两两成 1x2/2x1 骨牌、骨牌可跨区域边界、不得共边但可共角。出货的每一盘都由按区域枚举的穷举计数器数到「恰好一个解」，再由五条局部规则的零猜测求解器推到底；难度是量出来的（链条轮数 + 证明结点）。页面无构建、零依赖；tools/verify.sh 用真 headless Chrome 跑十腿 × 两种 URL 形态。",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node tools/check.mjs",
    "probe": "node tools/generator-probe.mjs",
    "test": "node tools/check.mjs",
    "balance": "node tools/balance.mjs",
    "dose": "node tools/balance.mjs --dose",
    "start": "node server.cjs",
    "prefix": "PREFIX=/z-biz-game-norinori-cos PORT=5280 node server.cjs",
    "verify": "bash tools/verify.sh",
    "verify:root": "SHAPES=root bash tools/verify.sh"
  },
  "keywords": ["puzzle", "norinori", "nikoli", "logic", "deduction"],
  "license": "MIT"
}
